# ==============================================================================
# Ruby NewsStudio — Cloud & Local Environment Configuration
# ==============================================================================

# ─── Database & Supabase PostgreSQL ──────────────────────────────────────────
# Pooled connection string used at runtime by Next.js app (PgBouncer port 6543)
DATABASE_URL="postgresql://postgres.xxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct unpooled connection string used exclusively by Prisma migrations & db push (port 5432)
DIRECT_URL="postgresql://postgres.xxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Supabase Management & Storage (Optional SDK integration)
SUPABASE_URL="https://xxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Database Connection Pool Tuning (Default: 5 for Supabase pooler compatibility)
DATABASE_POOL_MAX="5"

# ─── Cloudflare R2 / S3 Object Storage ───────────────────────────────────────
# "r2" | "minio" | "local" | "azure"
STORAGE_PROVIDER="r2"

# Cloudflare R2 S3-Compatible Endpoint (https://<ACCOUNT_ID>.r2.cloudflarestorage.com)
S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"

# R2 API Tokens (Permissions: Object Read & Write)
S3_ACCESS_KEY="<r2_access_key_id>"
S3_SECRET_KEY="<r2_secret_access_key>"
S3_BUCKET_NAME="news-studio"
S3_REGION="auto"
# Optional object key prefix when sharing an R2 bucket across multiple apps (e.g. "newsstudio")
S3_KEY_PREFIX="newsstudio"

# Public R2 CDN domain for direct browser asset playback (maps directly to bucket root, NO bucket suffix!)
# Example: https://pub-xxxxxxxxxxxxxxxxxxxxxxxx.r2.dev or https://assets.yourdomain.com
NEXT_PUBLIC_S3_PUBLIC_URL="https://pub-xxx.r2.dev"

# Fallback for MinIO local dev
NEXT_PUBLIC_S3_ENDPOINT="http://localhost:9000"

# ─── Clerk Authentication & Multi-Tenancy ────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# The owner organization. Existing data belongs to it and it is exempt from System Persona cap.
DEFAULT_ORG_ID="org_default_tenant"

# Super Administrator Access (comma-separated email list)
SUPER_ADMIN_EMAILS="danielazar@gmail.com"

# Secrets Encryption Key (32-byte hex string or >=32 chars utf8 string)
ENCRYPTION_KEY="change-me-to-a-32-byte-hex-string-for-aes-encryption"

# ─── LLM & AI Generation Engines ─────────────────────────────────────────────
# LLM Provider: "gemini" | "ollama"
LLM_PROVIDER="gemini"

# Gemini API (get key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=""

# Image Generation Engine: "agy" (Antigravity CLI) | "api" (Google GenAI Imagen / Gemini API) | "auto"
WARDROBE_IMAGE_ENGINE="agy"
GEMINI_IMAGE_ENGINE="agy"

# Full Scene Video Generation Engine: "veo" | "minimax" | "taomate" | "ltx"
DEFAULT_FULL_VIDEO_ENGINE="veo"

# Local Ollama Fallback (Local PC worker only)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen3.5:9b"

# OpenAI-Compatible Provider (e.g. Groq, Together, DeepSeek, Local vLLM/LM Studio)
OPENAI_COMPATIBLE_BASE_URL="https://api.openai.com/v1"
OPENAI_COMPATIBLE_API_KEY=""
OPENAI_COMPATIBLE_MODEL="gpt-4o-mini"

# ─── Local Pipeline Worker & Daemon Orchestration ────────────────────────────
# Secret token used by standalone Node workers to authenticate with cloud API
WORKER_API_KEY="change-me-to-a-long-random-string"

# Base URL pointing to the Next.js cloud deployment
MAIN_APP_URL="https://newsstudio.up.railway.app"

# Local HTTP loopback wake & preview bridge port (8766 avoids collision with CineZero on 8765)
WORKER_WAKE_PORT="8766"
NEXT_PUBLIC_WORKER_WAKE_PORT="8766"

# Local root folder containing external models/submodules on the local PC worker
VENDOR_ROOT="./vendor"

# Optional external local media roots (used by local pipeline worker before falling back to R2)
LOCAL_PUBLIC_ROOT=""
LOCAL_ACTION_LOOPS_ROOT=""
LOCAL_AVATARS_ROOT=""

# Disable all idle background browser polling to preserve Railway sleep & free credits
NEXT_PUBLIC_DISABLE_POLLING="true"

# ─── TTS Configuration ────────────────────────────────────────────────────────
NEXT_PUBLIC_TTS_MODE="server"
DEFAULT_TTS_ENGINE="piper" # "piper" | "styletts2" | "kokoro" | "f5_tts" | "cosyvoice_3"
TTS_PROFILE="studio" # "lightweight" (~450MB VRAM) | "studio" (~1.6GB VRAM) | "full" (~14GB VRAM)
DEFAULT_TTS_CHECKPOINT="BSC-LT/styletts2-spanish-multispeaker"
MODERN_TTS_SERVER_URL="http://localhost:8005"
NEXT_PUBLIC_MODERN_TTS_SERVER_URL="http://localhost:8005"
IDLE_UNLOAD_SECONDS="600" # Auto-Sleep VRAM Watchdog timeout in seconds

# ─── Local AI Microservices (PC Worker) ──────────────────────────────────────
COMFYUI_URL="http://localhost:8188"
NEXT_PUBLIC_COMFYUI_URL="http://localhost:8188"
COMFYUI_AUTO_START="false"
COMFY_WORKFLOW_VERSION="v2"

SADTALKER_SERVER_URL="http://localhost:8000"
TALKINGHEAD_SERVER_URL="http://localhost:8010"
MUSETALK_SERVER_URL="http://localhost:8010"
KEYSYNC_SERVER_URL="http://localhost:8008"
LIVEPORTRAIT_SERVER_URL="http://localhost:8009"
OBJECT3D_SERVER_URL="http://localhost:8020"
NEXT_PUBLIC_OBJECT3D_SERVER_URL="http://localhost:8020"

# ─── Stock Photos & Music ─────────────────────────────────────────────────────
PEXELS_API_KEY=""
PIXABAY_API_KEY=""
JAMENDO_CLIENT_ID=""
JAMENDO_CLIENT_SECRET=""
STOCK_PROVIDER_PRIORITY="pexels,pixabay"
MUSIC_PROVIDER_PRIORITY="pixabay-music,jamendo-music,ccmixter-music"

# ─── External Integrations ────────────────────────────────────────────────────
SHOPIFY_WEBHOOK_SECRET=""
CIVITAI_API_KEY=""

# Google Flow (Veo 3.1 & Characters Automation)
FLOW_PROJECT_ID=""
FLOW_PROJECT_NAME="News Studio"
FLOW_PROJECT_URL=""
FLOW_CONFIRM_POLICY="never"
FLOW_VIDEO_MODEL="veo-3.1-fast"
FLOW_TARGET_RESOLUTION="1080p"
FLOW_UPSCALE_1080P="true"
FLOW_DURATION="8s"
FLOW_ASPECT_RATIO="16:9"
FLOW_BATCH_COUNT="1"
FLOW_EXECUTION_MODE="direct"

IMAGE_GEN_BACKEND="cli"
VEO_VIDEO_BACKEND="cli"

# ─── Runtime & Logging ────────────────────────────────────────────────────────
NODE_OPTIONS="--max-old-space-size=384"
OTEL_SERVICE_NAME="ruby-newsstudio"
LOG_LEVEL="info"

# Multi-Platform Newsroom Chat SDK Bot (Optional)
SLACK_BOT_TOKEN=""
SLACK_SIGNING_SECRET=""
DISCORD_BOT_TOKEN=""
DISCORD_PUBLIC_KEY=""
DISCORD_APPLICATION_ID=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET_TOKEN=""
NEWSROOM_APPROVAL_CHANNELS=""
REDIS_URL=""
TAVILY_API_KEY=""
FIRECRAWL_API_KEY=""
