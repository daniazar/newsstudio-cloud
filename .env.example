# Database
DATABASE_URL="postgresql://newsstudio:newsstudiopassword@localhost:5432/newsstudio?schema=public"

# LLM Provider: "gemini" | "ollama"
LLM_PROVIDER="gemini"

# Gemini API (get key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=""

# Image Generation Engine: "agy" (Antigravity CLI) | "api" (Google GenAI Imagen / Gemini API) | "auto"
WARDROBE_IMAGE_ENGINE="agy"
GEMINI_IMAGE_ENGINE="agy"

# Ollama (local)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen3.5:9b"

# OpenAI-Compatible Provider (e.g. Groq, Together, DeepSeek, Local vLLM/LM Studio)
OPENAI_COMPATIBLE_BASE_URL="https://api.openai.com/v1"
OPENAI_COMPATIBLE_API_KEY=""
OPENAI_COMPATIBLE_MODEL="gpt-4o-mini"

# Inngest
INNGEST_DEV=1 # Set to 0 in production cloud deployments
INNGEST_SIGNING_KEY="" # Required for Inngest Cloud production webhook signing
INNGEST_EVENT_KEY=""   # Required for sending events to Inngest Cloud

# Database Connection Pool Tuning
DATABASE_POOL_MAX="15" # Max PostgreSQL client pool size per replica/instance

# Asset paths (Dev only fallback; Cloud deployments use STORAGE_PROVIDER="minio" | "azure")
# ASSETS_PENDING_DIR="./public/assets/pending"
# ASSETS_COMPLETED_DIR="./public/assets/completed"


# stock photos and music
PEXELS_API_KEY="your_key_here"
PIXABAY_API_KEY="your_key_here"
JAMENDO_CLIENT_ID="your_client_id_here"
JAMENDO_CLIENT_SECRET="your_client_secret_here"
STOCK_PROVIDER_PRIORITY="pexels,pixabay"
MUSIC_PROVIDER_PRIORITY="pixabay-music,jamendo-music,ccmixter-music"
# TTS Configuration
NEXT_PUBLIC_TTS_MODE="server"
DEFAULT_TTS_ENGINE="piper" # "piper" | "styletts2" | "kokoro" | "f5_tts" | "cosyvoice_3"
TTS_PROFILE="studio" # "lightweight" (~450MB VRAM) | "studio" (~1.6GB VRAM) | "full" (~14GB VRAM)
DEFAULT_TTS_CHECKPOINT="BSC-LT/styletts2-spanish-multispeaker"
MODERN_TTS_SERVER_URL="http://localhost:8005"
NEXT_PUBLIC_MODERN_TTS_SERVER_URL="http://localhost:8005"
IDLE_UNLOAD_SECONDS="600" # Auto-Sleep VRAM Watchdog timeout in seconds (600 = 10 minutes, 0 = disabled)

# Polling Configuration
NEXT_PUBLIC_DISABLE_POLLING="false" # Set to "true" to disable background auto-polling completely system-wide

# COMFY URL
COMFYUI_URL=http://localhost:8188
NEXT_PUBLIC_COMFYUI_URL=http://localhost:8188
COMFYUI_AUTO_START="false" # Always false in cloud containers; ComfyUI runs in separate GPU container

# AI Microservice URLs
SADTALKER_SERVER_URL=http://localhost:8000
TALKINGHEAD_SERVER_URL=http://localhost:8010
MUSETALK_SERVER_URL=http://localhost:8010 # Consolidated natively into Modern-TalkingHead-Server (Port 8010)
KEYSYNC_SERVER_URL=http://localhost:8008
LIVEPORTRAIT_SERVER_URL=http://localhost:8009
# 3D Product Turntable orchestrator (vendor/Object3D-Server, docker-compose.object3d.yml).
# Port 8020 — 8010 is Modern-TalkingHead and 8012–8019 are talking-head engines.
OBJECT3D_SERVER_URL="http://localhost:8020"
NEXT_PUBLIC_OBJECT3D_SERVER_URL="http://localhost:8020" # Browser-side endpoint for 3D Product Lab

# Full Scene Video Generation Engine: "veo" | "minimax" | "taomate" | "ltx"
# "veo": Zero local VRAM, Google Veo 3.1 Cloud API (recommended for cloud/lightweight deployments)
# "minimax" / "taomate": Ultra-fast 2-step TaoMate distilled diffusion on local ComfyUI (~14-28s)
# "ltx": LTX-Video 2.5 local diffusion on ComfyUI with automatic fallback to Veo API
DEFAULT_FULL_VIDEO_ENGINE="veo"

# ComfyUI Workflow Version: "v1" (standard JSONs) | "v2" (uses cloned *_v2.json templates for edits)
COMFY_WORKFLOW_VERSION="v2"

# Storage Abstraction: "local" | "minio" | "azure"
STORAGE_PROVIDER="minio"
S3_ENDPOINT="http://localhost:9000" # Internal server endpoint (e.g., http://minio:9000 in Docker)
NEXT_PUBLIC_S3_ENDPOINT="http://localhost:9000" # Client/browser-facing endpoint
S3_ACCESS_KEY="admin"
S3_SECRET_KEY="password123"
S3_BUCKET_NAME="news-studio"

# Binary Path Overrides (Optional — dynamically detected via system PATH if unset)
# FFMPEG_PATH="/usr/bin/ffmpeg"
# FFPROBE_PATH="/usr/bin/ffprobe"
# PYTHON_PATH="/usr/bin/python3"
# CHROME_PATH="/usr/bin/chromium"
# COMFY_MODELS_DIR="/app/models"

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_ # In production cloud, use pk_live_...
CLERK_SECRET_KEY=sk_test_ # In production cloud, use sk_live_...

# Multi-tenancy (Sprint 7.1)
# The owner organization. Existing/backfilled data belongs to it and it is exempt
# from the System Persona generation cap. Set this to your real Clerk org id (org_...).
# After changing it, re-run: node_modules/.bin/jiti scripts/backfill-tenants.ts
DEFAULT_ORG_ID="org_default_tenant"

# Super Administrator Access (comma-separated email list)
SUPER_ADMIN_EMAILS="danielazar@gmail.com"

# Secrets Encryption Key (32-byte hex string or >=32 chars utf8 string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# Shopify Webhook HMAC Secret
SHOPIFY_WEBHOOK_SECRET=""

# Pipeline Worker (Sprint P-1)
WORKER_API_KEY="change-me-to-a-long-random-string"
MAIN_APP_URL="http://localhost:3000" # Use internal container network name (e.g. http://web:3000) or public HTTPS in cloud

# Civitai Model Download Authentication
CIVITAI_API_KEY=""

# Google Flow (Veo 3.1 & Characters Automation)
FLOW_PROJECT_ID="065b7352-6e4f-4aa9-b420-eab8beeebcdd"
FLOW_PROJECT_NAME="News Studio"
FLOW_PROJECT_URL="https://flow.google.com/project/065b7352-6e4f-4aa9-b420-eab8beeebcdd"
FLOW_CONFIRM_POLICY="never"
FLOW_VIDEO_MODEL="veo-3.1-fast"
FLOW_TARGET_RESOLUTION="1080p"
FLOW_UPSCALE_1080P="true"
FLOW_DURATION="8s"
FLOW_ASPECT_RATIO="16:9"
FLOW_BATCH_COUNT="1"
FLOW_EXECUTION_MODE="direct"

# E-Commerce Media Generation Backends: "api" | "cli"
# "api" uses direct @google/genai SDK (Imagen 3 / Veo 3.1)
# "cli" uses Antigravity CLI (agy) or Flow web automation
IMAGE_GEN_BACKEND="cli"
VEO_VIDEO_BACKEND="cli"

# Node.js V8 Engine Heap & GC Optimization
# For local high-RAM workstations (64GB+):
NODE_OPTIONS="--max-old-space-size=16384 --expose-gc"
# For cloud container deployments (ACA / Cloud Run with 4GB RAM allocation):
# NODE_OPTIONS="--max-old-space-size=3072 --expose-gc"

# OpenTelemetry Instrumentation
OTEL_SERVICE_NAME="ruby-newsstudio"

# Structured Logging (trace | debug | info | warn | error | fatal | silent)
LOG_LEVEL="info"

# Multi-Platform Newsroom Chat SDK Bot (Slack, Discord, Telegram)
# Slack Adapter Credentials (https://api.slack.com/apps)
SLACK_BOT_TOKEN=""
SLACK_SIGNING_SECRET=""

# Discord Adapter Credentials (https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=""
DISCORD_PUBLIC_KEY=""
DISCORD_APPLICATION_ID=""

# Telegram Adapter Credentials (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET_TOKEN=""

# Approval Broadcast Channels (comma-separated platform:channelId targets)
# Example: "slack:C0123456789,discord:123456789012345678,telegram:-1001234567890"
NEWSROOM_APPROVAL_CHANNELS=""

# Distributed State, Rate Limiting & Bot Persistence (Optional — falls back to local memory when empty)
# REDIS_URL=redis://localhost:6379
REDIS_URL=""

# Live Web Search & Smart Anti-Bot Scraping (Optional — Phase 3)
TAVILY_API_KEY=""
FIRECRAWL_API_KEY=""
