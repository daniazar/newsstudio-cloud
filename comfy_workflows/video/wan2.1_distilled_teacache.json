{
  "1": {
    "inputs": {
      "model": "wan2.1_i2v_480p_1.3B_bf16.safetensors",
      "base_precision": "bf16",
      "quantization": "disabled",
      "load_device": "offload_device",
      "attention_mode": "sageattention_2"
    },
    "class_type": "WanVideoModelLoader",
    "_meta": { "title": "Wan 2.1 Distilled 1.3B Loader (8GB VRAM Optimized)" }
  },
  "2": {
    "inputs": {
      "model_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "precision": "fp8_e4m3fn"
    },
    "class_type": "LoadWanVideoT5TextEncoder",
    "_meta": { "title": "Load T5 Text Encoder (FP8 Scaled)" }
  },
  "3": {
    "inputs": {
      "model_name": "wan_2.1_vae.safetensors",
      "precision": "bf16"
    },
    "class_type": "WanVideoVAELoader",
    "_meta": { "title": "Load Color VAE" }
  },
  "4": {
    "inputs": {
      "clip_name": "CLIP-ViT-H-14-laion2B-s32B-b79K.safetensors"
    },
    "class_type": "CLIPVisionLoader",
    "_meta": { "title": "Load CLIP Vision" }
  },
  "5": {
    "inputs": {
      "image": "avatar.png",
      "upload": "image"
    },
    "class_type": "LoadImage",
    "_meta": { "title": "Load Driver Keyframe" }
  },
  "6": {
    "inputs": {
      "clip_vision": ["4", 0],
      "image_1": ["5", 0],
      "strength_1": 1.0,
      "strength_2": 1.0,
      "crop": "center",
      "combine_embeds": "average",
      "force_offload": true
    },
    "class_type": "WanVideoClipVisionEncode",
    "_meta": { "title": "CLIP Vision Encode" }
  },
  "7": {
    "inputs": {
      "positive_prompt": "hyper-photorealistic female news anchor in dark blazer, broadcast studio, subtle head movement and gentle breathing, professional studio key light, 8k raw photo",
      "negative_prompt": "overexposed, brightening, changing colors, flickering, static, blurry, distorted, noise, low quality",
      "t5": ["2", 0],
      "force_offload": true
    },
    "class_type": "WanVideoTextEncode",
    "_meta": { "title": "Text Encode" }
  },
  "8": {
    "inputs": {
      "start_image": ["5", 0],
      "vae": ["3", 0],
      "clip_embeds": ["6", 0],
      "width": 480,
      "height": 832,
      "num_frames": 25,
      "noise_aug_strength": 0.0,
      "start_latent_strength": 1.0,
      "end_latent_strength": 1.0,
      "fun_or_fl2v_model": false,
      "force_offload": true
    },
    "class_type": "WanVideoImageToVideoEncode",
    "_meta": { "title": "I2V Latent Encode" }
  },
  "9": {
    "inputs": {
      "model": ["1", 0],
      "rel_l1_thresh": 0.15,
      "start_step": 1,
      "end_step": 12
    },
    "class_type": "WanVideoTeaCache",
    "_meta": { "title": "TeaCache Step Acceleration (3x Speedup)" }
  },
  "10": {
    "inputs": {
      "model": ["9", 0],
      "image_embeds": ["8", 0],
      "text_embeds": ["7", 0],
      "steps": 12,
      "cfg": 3.0,
      "shift": 3.5,
      "seed": 42,
      "scheduler": "unipc",
      "riflex_freq_index": 0,
      "rope_function": "comfy",
      "force_offload": true
    },
    "class_type": "WanVideoSampler",
    "_meta": { "title": "12-Step Distilled Sampler" }
  },
  "11": {
    "inputs": {
      "vae": ["3", 0],
      "samples": ["10", 0],
      "enable_vae_tiling": true,
      "tile_x": 256,
      "tile_y": 256,
      "tile_stride_x": 128,
      "tile_stride_y": 128
    },
    "class_type": "WanVideoDecode",
    "_meta": { "title": "Tiled Video Latent Decode" }
  },
  "12": {
    "inputs": {
      "images": ["11", 0],
      "filename_prefix": "wan_distilled_teacache_output",
      "format": "video/h264-mp4",
      "frame_rate": 25.0,
      "loop_count": 0,
      "pingpong": false,
      "save_output": true
    },
    "class_type": "VHS_VideoCombine",
    "_meta": { "title": "Export MP4 Video" }
  }
}
