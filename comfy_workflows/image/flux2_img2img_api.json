{
  "1": {
    "inputs": {
      "image": "input_image.png",
      "upload": "image"
    },
    "class_type": "LoadImage",
    "_meta": { "title": "Load Source Image" }
  },
  "2": {
    "inputs": {
      "unet_name": "flux2_dev_fp8mixed.safetensors",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": { "title": "Load FLUX.2 UNET" }
  },
  "3": {
    "inputs": {
      "clip_name": "mistral_3_small_flux2_fp8.safetensors",
      "type": "flux2",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": { "title": "Load FLUX.2 Text Encoder (Mistral)" }
  },
  "4": {
    "inputs": {
      "vae_name": "flux2-vae.safetensors"
    },
    "class_type": "VAELoader",
    "_meta": { "title": "Load FLUX.2 VAE" }
  },
  "11": {
    "inputs": {
      "lora_name": "custom_person_flux2_lora.safetensors",
      "strength_model": 1.0,
      "strength_clip": 1.0,
      "model": ["2", 0],
      "clip": ["3", 0]
    },
    "class_type": "LoraLoader",
    "_meta": { "title": "Load FLUX.2 Person LoRA" }
  },
  "5": {
    "inputs": {
      "text": "highly detailed realistic portrait of a person, professional studio lighting, clear face",
      "clip": ["11", 1]
    },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Text Prompt" }
  },
  "6": {
    "inputs": {
      "guidance": 3.5,
      "conditioning": ["5", 0]
    },
    "class_type": "FluxGuidance",
    "_meta": { "title": "FLUX.2 Guidance" }
  },
  "7": {
    "inputs": {
      "pixels": ["1", 0],
      "vae": ["4", 0]
    },
    "class_type": "VAEEncode",
    "_meta": { "title": "VAE Encode (Start Latent)" }
  },
  "8": {
    "inputs": {
      "seed": 12345,
      "steps": 25,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 0.5,
      "model": ["11", 0],
      "positive": ["6", 0],
      "negative": ["5", 0],
      "latent_image": ["7", 0]
    },
    "class_type": "KSampler",
    "_meta": { "title": "FLUX.2 Sampler (img2img)" }
  },
  "9": {
    "inputs": {
      "samples": ["8", 0],
      "vae": ["4", 0]
    },
    "class_type": "VAEDecode",
    "_meta": { "title": "VAE Decode" }
  },
  "10": {
    "inputs": {
      "images": ["9", 0],
      "filename_prefix": "flux2_lora_output"
    },
    "class_type": "SaveImage",
    "_meta": { "title": "Save Output Image" }
  }
}
