{
  "1": {
    "inputs": {
      "image": "input_image.png",
      "upload": "image"
    },
    "class_type": "LoadImage",
    "_meta": { "title": "Load Primary Image" }
  },
  "101": {
    "inputs": {
      "image": "partner_image.png",
      "upload": "image"
    },
    "class_type": "LoadImage",
    "_meta": { "title": "Load Partner Image" }
  },
  "2": {
    "inputs": {
      "unet_name": "flux2_dev_fp8mixed.safetensors",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": { "title": "Load FLUX.2 UNET" }
  },
  "3": {
    "inputs": {
      "clip_name": "mistral_3_small_flux2_fp8.safetensors",
      "type": "flux2",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": { "title": "Load FLUX.2 Text Encoder (Mistral)" }
  },
  "4": {
    "inputs": {
      "vae_name": "flux2-vae.safetensors"
    },
    "class_type": "VAELoader",
    "_meta": { "title": "Load FLUX.2 VAE" }
  },
  "11": {
    "inputs": {
      "lora_name": "custom_person_flux2_lora.safetensors",
      "strength_model": 1.0,
      "strength_clip": 1.0,
      "model": ["2", 0],
      "clip": ["3", 0]
    },
    "class_type": "LoraLoader",
    "_meta": { "title": "Load FLUX.2 Person LoRA" }
  },
  "12": {
    "inputs": {
      "pulid_file": "pulid_flux_v0.9.1.safetensors"
    },
    "class_type": "PulidFluxModelLoader",
    "_meta": { "title": "Load PuLID Flux Model" }
  },
  "13": {
    "inputs": {
      "provider": "CUDA"
    },
    "class_type": "PulidFluxInsightFaceLoader",
    "_meta": { "title": "Load InsightFace (PuLID Flux)" }
  },
  "14": {
    "inputs": {},
    "class_type": "PulidFluxEvaClipLoader",
    "_meta": { "title": "Load Eva Clip (PuLID Flux)" }
  },
  "15": {
    "inputs": {
      "model": ["11", 0],
      "pulid_flux": ["12", 0],
      "eva_clip": ["14", 0],
      "face_analysis": ["13", 0],
      "image": ["1", 0],
      "weight": 0.85,
      "start_at": 0.0,
      "end_at": 1.0
    },
    "class_type": "ApplyPulidFlux",
    "_meta": { "title": "Apply PuLID Primary" }
  },
  "16": {
    "inputs": {
      "model": ["15", 0],
      "pulid_flux": ["12", 0],
      "eva_clip": ["14", 0],
      "face_analysis": ["13", 0],
      "image": ["101", 0],
      "weight": 0.85,
      "start_at": 0.0,
      "end_at": 1.0
    },
    "class_type": "ApplyPulidFlux",
    "_meta": { "title": "Apply PuLID Partner" }
  },
  "5": {
    "inputs": {
      "text": "highly detailed realistic portrait of two people standing side by side, professional studio lighting, clear faces",
      "clip": ["11", 1]
    },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Text Prompt" }
  },
  "6": {
    "inputs": {
      "guidance": 3.5,
      "conditioning": ["5", 0]
    },
    "class_type": "FluxGuidance",
    "_meta": { "title": "FLUX.2 Guidance" }
  },
  "7": {
    "inputs": {
      "pixels": ["1", 0],
      "vae": ["4", 0]
    },
    "class_type": "VAEEncode",
    "_meta": { "title": "VAE Encode (Start Latent)" }
  },
  "8": {
    "inputs": {
      "seed": 12345,
      "steps": 25,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 0.5,
      "model": ["16", 0],
      "positive": ["6", 0],
      "negative": ["5", 0],
      "latent_image": ["7", 0]
    },
    "class_type": "KSampler",
    "_meta": { "title": "FLUX.2 Sampler (img2img)" }
  },
  "9": {
    "inputs": {
      "samples": ["8", 0],
      "vae": ["4", 0]
    },
    "class_type": "VAEDecode",
    "_meta": { "title": "VAE Decode" }
  },
  "10": {
    "inputs": {
      "images": ["9", 0],
      "filename_prefix": "flux2_pulid_output"
    },
    "class_type": "SaveImage",
    "_meta": { "title": "Save Output Image" }
  }
}
