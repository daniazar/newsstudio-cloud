{
  "1": {
    "inputs": {
      "image": "input_image.png",
      "upload": "image"
    },
    "class_type": "LoadImage",
    "_meta": { "title": "Load Source Image" }
  },
  "2": {
    "inputs": {
      "ckpt_name": "moodyDesireMix_v30.safetensors"
    },
    "class_type": "CheckpointLoaderSimple",
    "_meta": { "title": "Load SDXL Checkpoint" }
  },
  "3": {
    "inputs": {
      "text": "score_9, score_8_up, score_7_up, rating_explicit, photorealistic, highly detailed face portrait, 8k raw photo quality",
      "clip": ["2", 1]
    },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Positive Text Prompt" }
  },
  "4": {
    "inputs": {
      "text": "score_4, score_3, score_2, score_1, 3d, anime, cartoon, bad anatomy, bad hands, blurry, low quality, distorted",
      "clip": ["2", 1]
    },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Negative Text Prompt" }
  },
  "7": {
    "inputs": {
      "pixels": ["1", 0],
      "vae": ["2", 2]
    },
    "class_type": "VAEEncode",
    "_meta": { "title": "VAE Encode (Source Image)" }
  },
  "8": {
    "inputs": {
      "seed": 12345,
      "steps": 30,
      "cfg": 5.5,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 0.5,
      "model": ["2", 0],
      "positive": ["3", 0],
      "negative": ["4", 0],
      "latent_image": ["7", 0]
    },
    "class_type": "KSampler",
    "_meta": { "title": "SDXL KSampler" }
  },
  "9": {
    "inputs": {
      "samples": ["8", 0],
      "vae": ["2", 2]
    },
    "class_type": "VAEDecode",
    "_meta": { "title": "VAE Decode" }
  },
  "10": {
    "inputs": {
      "images": ["9", 0],
      "filename_prefix": "sdxl_output"
    },
    "class_type": "SaveImage",
    "_meta": { "title": "Save Output Image" }
  }
}
