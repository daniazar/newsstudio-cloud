// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Sprint 7.1 — Multi-Tenancy
// ============================================================

model Company {
  id               String   @id // Maps to Clerk orgId
  name             String
  tier             String   @default("free") // "free" | "pro" | "enterprise"
  stripeCustomerId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  stories        Story[]
  rssFeeds       RssFeed[]
  rssGroups      RssGroup[]
  brands         Brand[]
  personas       Persona[]
  personaAvatars PersonaAvatar[]
  personaVoices  PersonaVoice[]
  socialChannels SocialChannel[]
  schedules      Schedule[]
  videos         Video[]
  notifications  Notification[]
  usageLogs      UsageLog[]
  generationJobs GenerationJob[]
  aiTokenUsages  AiTokenUsage[]
  productCampaigns ProductCampaign[]
  product3DAssets Product3DAsset[]
  storefronts    Storefront[]
  tenantReservations TenantReservation[]
  systemSettings SystemSetting[]
  isPipelinePaused Boolean @default(false)
  minJobsAudio     Int      @default(1)
  minJobsVideo     Int      @default(1)
  minJobsRender    Int      @default(1)
  minJobsImage     Int      @default(1)
}

model TenantReservation {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type            String    // "token" | "video_minute" | "storage_gb" | "persona_generation" | "tts_credits" | "video_credits" | "render_credits" | "llm_tokens"
  amount          Float
  status          String    @default("RESERVED") // "RESERVED" | "COMMITTED" | "ROLLED_BACK" | "EXPIRED"
  metadata        String?   // JSON payload details
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId, status])
  @@index([expiresAt])
  @@index([companyId, type, status, expiresAt])
}

model UsageLog {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  type      String   // "token" | "video_minute" | "storage_gb" | "persona_generation" | "tts_credits" | "video_credits" | "render_credits" | "llm_tokens"
  amount    Float    @default(1)
  personaId String?  // For System Persona generation cap tracking
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, personaId])
  @@index([companyId, type, createdAt])
}

model RssFeed {
  id                    String   @id @default(cuid())
  companyId             String
  company               Company @relation(fields: [companyId], references: [id])
  name                  String
  url                   String
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  stories               Story[]
  
  // Sprint 0 automation extensions
  fetchIntervalMinutes  Int      @default(60)
  isEnabled             Boolean  @default(true)
  lastFetchedAt         DateTime?
  lastErrorAt           DateTime?
  errorCount            Int      @default(0)
  defaultPersonaId      String?  // References a Persona id
  autoScript            Boolean  @default(true)
  autoPublish           Boolean  @default(false)
  requireApproval       Boolean  @default(true)
  articlesTotal         Int      @default(0)

  groups                RssGroup[]

  @@unique([companyId, url])
  @@index([companyId, createdAt])
  @@index([companyId, isEnabled])
  @@index([companyId, isEnabled, createdAt])
}

model Story {
  id          String      @id @default(cuid())
  companyId   String
  company     Company    @relation(fields: [companyId], references: [id])
  feedId      String
  feed        RssFeed     @relation(fields: [feedId], references: [id], onDelete: Cascade)
  title       String
  link        String
  description String?
  fullContent String?     // Scraped full article text
  author      String?
  pubDate     DateTime?
  guid        String
  category    String?     // Category tag from RSS
  status      String      @default("INGESTED") // StoryStatus enum mapped as string for SQLite
  errorLog    String?
  script      Script?
  video       Video?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Sprint 0 automation extensions
  articleImageUrls String? // JSON string array of image URLs
  articleVideoUrls String? // JSON string array of video URLs
  keywords         String? // JSON string array of keywords
  approvalStatus   String  @default("pending_review") // "pending_review" | "approved" | "rejected"

  @@unique([companyId, link])
  @@unique([companyId, guid])
  @@index([companyId, pubDate])
  @@index([companyId, status])
  @@index([companyId, status, pubDate])
  @@index([companyId, feedId])
  @@index([companyId, feedId, pubDate])
  @@index([companyId, createdAt])
  @@index([companyId, approvalStatus, pubDate])
  @@index([companyId, approvalStatus, createdAt])
  @@index([companyId, category, pubDate])
  @@index([feedId])
}

model Script {
  id        String    @id @default(cuid())
  storyId   String    @unique
  story     Story     @relation(fields: [storyId], references: [id], onDelete: Cascade)
  rawJson   String    // Full JSON blob from LLM
  headline  String?
  segments  Segment[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Segment {
  id                 String   @id @default(cuid())
  scriptId           String
  script             Script   @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  index              Int
  startTime          Float
  endTime            Float
  text               String
  spokenText         String?  // Phonetically normalized speech script for TTS synthesis
  imagePrompt        String
  backgroundPrompt   String?  // AI background replacement prompt
  assetPath          String?  // Path to assigned B-roll mp4 or image
  assetType          String?  // "video" | "image" | "placeholder"
  mediaSettings      String?  // JSON string containing scale, trim, pan
  transitionType     String?  @default("fade") // fade, slide, zoom, glitch
  stickers           String?  // JSON array of stickers
  personaId          String?  // Modern-TTS persona id
  voiceParams        String?  // Modern-TTS voice params JSON
  audioPath          String?  // Path to generated audio file (S3/MinIO)
  presenterVideoPath String?  // Path to lip-sync video in MinIO
  presenterStatus    String?  // "pending" | "generating" | "done" | "error"
  personaAvatarUrl   String?  // Chosen avatar image for this segment
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Sprint 0 automation extensions
  keyword            String?
  stockAssetSource   String?
  stockAssetQuery    String?
  suggestedPersonaId String?
  sceneMode          String   @default("portrait") // "portrait" | "full_body" | "broll_only"

  // Pipeline generation fields
  presenterType      String?  // "sadtalker" | "echomimic" | "none" — default: sadtalker
  sceneStrategy      String?  // "echomimic" | "sadtalker" | "article_image" | "stock"
  backgroundType     String?  // "stock" | "article_image" | "custom"
  echoImagePairId    String?  // PersonaImagePair id (when presenterType = "echomimic" or sceneStrategy = "echomimic")
  mediaHistory       String?  // JSON array of cached persona generations [{ personaId, audioPath, presenterVideoPath, expiresAt }]
  presetChoice       String?
  personaImagePrompt String?
  presenterVideoPrompt String?
  generatedAvatarKey String?
  partnerPersonaId   String?  // Secondary persona id for multi-persona interactions
  partnerAvatarUrl   String?  // Avatar image path for secondary persona

  @@unique([scriptId, index])
  @@index([partnerPersonaId])
  @@index([personaId])
  @@index([assetPath])
  @@index([presenterVideoPath])
  @@index([audioPath])
}

model Video {
  id                 String   @id @default(cuid())
  companyId          String
  company            Company @relation(fields: [companyId], references: [id])
  storyId            String   @unique
  story              Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  status             String   @default("PENDING") // VideoStatus enum mapped as string
  aspectRatio        String   @default("vertical") // "vertical" | "horizontal"
  outputPath         String?
  thumbnailPath      String?
  duration           Float?
  presenterVideoPath String?  // Lip-synced video from AI avatar
  presenterAudioPath String?  // Voice audio

  // Platform metadata for publishing
  youtubeTitle       String?
  youtubeDescription String?
  youtubeTags        String?  // JSON array stored as string
  youtubeCategory    String?
  instagramCaption   String?
  instagramHashtags  String?  // JSON array stored as string
  instagramAltText   String?

  globalBgVideoPath  String?  // Optional global background video
  bgMusicPath        String?  // Optional background music track
  bgMusicVolume      Float?   @default(0.2) // Volume (0.0 to 1.0)
  sloganId           String?  @default("ruby-tech") // Intro slogan identifier
  outroId            String?  @default("subscribe") // subscribe, next-time, thanks
  personaId          String?  @default("ruby") // TTS Persona selection
  renderProgress     Float?   @default(0) // 0 to 100
  captionStyle       String?  @default("beast") // beast, minimal, breaking

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Sprint 0 automation extensions
  publishStatus       String?  @default("PENDING")
  totalViews          Int      @default(0)
  totalLikes          Int      @default(0)
  thumbnailStorageKey String?
  subtitlePath        String?
  bgMusicId           String?
  bgMusic             BackgroundMusic? @relation(fields: [bgMusicId], references: [id])
  publishes           VideoPublish[]

  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([companyId, status, createdAt])
  @@index([companyId, personaId])
  @@index([companyId, publishStatus])
  @@index([companyId, aspectRatio, createdAt])
  @@index([companyId, totalViews])
  @@index([bgMusicId])
}

// ============================================================
// Sprint 0 New Models
// ============================================================

model Persona {
  id               String          @id @default(cuid())
  companyId        String?
  company          Company?        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  slug             String          @unique
  name             String
  role             String
  gender           String
  language         String
  description      String?
  bio              String?
  systemPrompt     String?         // LLM instructions for persona assignment
  visualPrompt     String?
  visualPromptNeutral String?
  visualBodyPrompt String?
  voiceParams      String?         // JSON: speed, pitch, exaggerated, cfg_weight, etc.
  avatarType       String          @default("static_image") // "face_crop" | "full_body" | "static_image"
  defaultAvatarId  String?
  styleGuidelines  String?         // Visual/style guidelines
  isActive         Boolean         @default(true)
  isSystemPersona  Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  avatars          PersonaAvatar[]
  voices           PersonaVoice[]
  brands           Brand[]
  imagePairs       PersonaImagePair[]
  masterImages     PersonaMasterImage[]
  actionLoops      PersonaActionLoop[]

  @@index([companyId, isSystemPersona])
  @@index([isSystemPersona, isActive])
  @@index([companyId, isActive])
}

model PersonaMasterImage {
  id             String              @id @default(cuid())
  personaId      String
  persona        Persona             @relation(fields: [personaId], references: [id], onDelete: Cascade)
  attire         String
  poseType       String              @default("seated_desk") // "seated_desk" | "standing_mic"
  frontalObjects String?             // JSON string describing Stage 2 frontal objects
  promptUsed     String?
  storageKey     String              // MinIO asset key (e.g. avatars/ruby/ruby_master_pose.png)
  url            String?
  isTransparent  Boolean             @default(true)
  isDefault      Boolean             @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  actionLoops    PersonaActionLoop[]

  @@index([personaId])
}

model PersonaActionLoop {
  id              String             @id @default(cuid())
  personaId       String
  persona         Persona            @relation(fields: [personaId], references: [id], onDelete: Cascade)
  masterImageId   String
  masterImage     PersonaMasterImage @relation(fields: [masterImageId], references: [id], onDelete: Cascade)
  actionName      String             // "state_idle" | "state_gesture_left" | "state_gesture_right" | "state_emphasis_nod"
  actionPrompt    String?
  durationSec     Float              @default(3.0)
  frameCount      Int                @default(75)
  fps             Int                @default(25)
  baseVideoKey    String?            // MinIO asset key for 1.5s base video
  pingPongVideoKey String            // MinIO asset key for 3.0s ping-pong video loop
  latentsCacheKey String?            // MinIO asset key for pre-cached MuseTalk latents.pt
  coordsCacheKey  String?            // MinIO asset key for pre-cached MuseTalk coords.pkl
  maskCacheKey    String?            // MinIO asset key for pre-cached MuseTalk mask_coords.pkl
  isPreCached     Boolean            @default(false)
  emotion         String?            // "neutral_composed" | "enthusiastic_upbeat" | "grave_solemn" | "analytical_scrutiny" | "empathetic_heartfelt"
  rhetoricAction  String?            // "little_movement" | "explaining" | "emphasizing" | "comparing" | "welcoming" | "presenting_graphic" | "forward_lean" | "side_turn"
  energyLevel     String?            // "low" | "medium" | "high"
  poseState       String?            // "M1" | "M2" | "M3" | "M4" | "M5"
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([personaId])
  @@index([masterImageId])
  @@index([personaId, actionName])
  @@index([personaId, emotion])
  @@index([personaId, rhetoricAction])
}

model PersonaAvatar {
  id         String   @id @default(cuid())
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  personaId  String
  persona    Persona  @relation(fields: [personaId], references: [id], onDelete: Cascade)
  label      String
  url        String
  storageKey String
  frameType  String   @default("portrait") // "portrait" | "full_body" | "background_free"
  isDefault  Boolean  @default(false)
  presetName String?  // Preset slug if generated
  promptUsed String?  // Prompt text if generated
  createdAt  DateTime @default(now())

  @@index([personaId, frameType])
  @@index([personaId, presetName])
  @@index([companyId])
}

model PersonaVoice {
  id                  String   @id @default(cuid())
  companyId           String?
  company             Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  personaId           String
  persona             Persona  @relation(fields: [personaId], references: [id], onDelete: Cascade)
  label               String
  audioPath           String
  storageKey          String
  embeddingPath       String?  // Path to pre-cached PyTorch speaker embedding tensor (.pt file)
  embeddingStorageKey String?
  isDefault           Boolean  @default(false)
  language            String   @default("en")
  duration            Float    @default(0)
  createdAt           DateTime @default(now())

  @@index([personaId, isDefault])
  @@index([isDefault])
  @@index([companyId])
}



model SocialChannel {
  id                  String    @id @default(cuid())
  companyId           String
  company             Company  @relation(fields: [companyId], references: [id])
  brandId             String
  brand               Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  platform            String    // "youtube" | "instagram" | "tiktok"
  name                String
  handle              String
  profileImageUrl     String?
  clientId            String?   // Encrypted client ID
  clientSecret        String?   // Encrypted client secret
  accessToken         String?   // Encrypted token string
  refreshToken        String?   // Encrypted token string
  tokenExpiry         DateTime?
  subscriberCount     Int       @default(0)
  followerCount       Int       @default(0)
  lastSyncedAt        DateTime?
  isActive            Boolean   @default(true)
  titleTemplate       String?   // Platform-specific override
  descriptionTemplate String?   // Platform-specific override
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  publishes           VideoPublish[]

  @@unique([companyId, platform, handle])
  @@index([brandId])
  @@index([companyId, brandId])
  @@index([companyId, platform])
}

model Brand {
  id                  String          @id @default(cuid())
  companyId           String
  company             Company        @relation(fields: [companyId], references: [id])
  name                String
  handle              String
  profileImageUrl     String?
  titleTemplate       String?         // Default template
  descriptionTemplate String?         // Default template
  watermarkStorageKey String?         // Sprint 4: Brand identity logo overlay
  hashtagBank         String?         // Sprint 4: Global hashtags to append
  
  // Brand Identity features
  toneOfVoice          String?
  primaryColor         String?
  secondaryColor       String?
  captionStyle         String?
  preferredMusicMood   String?
  introVideoStorageKey String?
  outroVideoStorageKey String?
  logoStorageKeys      String?         // Comma separated list of keys
  
  autoPublish         Boolean         @default(false)
  isActive            Boolean         @default(true)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  channels            SocialChannel[]
  rssGroups           RssGroup[]
  personas            Persona[]
  schedules           Schedule[]
  productCampaigns    ProductCampaign[]

  @@unique([companyId, handle])
  @@index([companyId, createdAt])
  @@index([companyId, isActive])
}

model RssGroup {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  color     String?   @default("#3b82f6")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  feeds     RssFeed[]
  brands    Brand[]

  @@unique([companyId, name])
  @@index([companyId])
}

model VideoPublish {
  id              String        @id @default(cuid())
  videoId         String
  video           Video         @relation(fields: [videoId], references: [id], onDelete: Cascade)
  channelId       String
  channel         SocialChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  platformVideoId String?
  status          String        @default("SCHEDULED") // "SCHEDULED" | "PUBLISHED" | "FAILED"
  publishedAt     DateTime?
  scheduledFor    DateTime?
  title           String?
  description     String?
  tags            String?       // JSON array stored as string
  viewCount       Int           @default(0)
  likeCount       Int           @default(0)
  commentCount    Int           @default(0)
  lastSyncedAt    DateTime?
  createdAt       DateTime      @default(now())

  @@index([channelId, status])
  @@index([videoId])
  @@index([status, publishedAt])
  @@index([status, createdAt])
}

model Schedule {
  id              String        @id @default(cuid())
  companyId       String
  company         Company      @relation(fields: [companyId], references: [id])
  name            String
  cronExpression  String
  mode            String        @default("latest_n") // "latest_n" | "roundup" | "curated_top"
  count           Int           @default(1)
  feedIds         String        // JSON array stored as string
  brandId         String
  brand           Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  targetChannelIds String?      // JSON array of selected channel IDs to publish to
  personaId       String
  autoScript      Boolean       @default(true)
  autoPublish     Boolean       @default(false)
  requireApproval Boolean       @default(true)
  isActive        Boolean       @default(true)
  lastRunAt       DateTime?
  nextRunAt       DateTime?
  lastRunStatus   String?
  selectionCriteria String?     // e.g., "Highest clickbait", "Most important"
  outputMode      String?       @default("roundup") // "roundup" | "individual"
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  runs            ScheduleRun[]

  @@index([companyId, isActive])
  @@index([brandId])
}

model ScheduleRun {
  id          String    @id @default(cuid())
  scheduleId  String
  schedule    Schedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  status      String    @default("RUNNING") // "RUNNING" | "SUCCESS" | "PARTIAL" | "FAILED"
  storyCount  Int       @default(0)
  errorLog    String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([scheduleId, createdAt])
  @@index([scheduleId, startedAt])
}

model StockAsset {
  id          String    @id @default(cuid())
  provider    String    // "pexels" | "pixabay" | "unsplash" | "coverr" | "mixkit"
  externalId  String
  query       String
  type        String    // "video" | "photo"
  url         String
  previewUrl  String?
  downloadUrl String
  width       Int?
  height      Int?
  duration    Float?
  license     String?
  usedCount   Int       @default(0)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@unique([provider, externalId])
  @@index([query, type, createdAt])
  @@index([type, createdAt])
}

model BackgroundMusic {
  id         String   @id @default(cuid())
  name       String
  mood       String   // "upbeat" | "serious" | "ambient" | "dramatic"
  url        String
  storageKey String
  duration   Float    @default(0)
  bpm        Int?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  videos     Video[]

  @@index([mood])
}

model Notification {
  id        String   @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  type      String   // "job_failed" | "video_ready" | "publish_done" | "system_alert"
  title     String
  message   String
  data      String?  // Optional JSON string
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([companyId, isRead, createdAt])
  @@index([companyId, createdAt])
  @@index([companyId, type, createdAt])
}

// ============================================================
// Pipeline — Distributed AI Generation
// ============================================================

model GenerationJob {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  storyId     String
  type        String    @default("full") // "audio" | "video_full" | "video_bubble" | "render" | "full" | "image" | "turntable_3d"
  status      String    @default("QUEUED")
  // QUEUED | TTS_IN_PROGRESS | VIDEO_IN_PROGRESS | RENDER_IN_PROGRESS | TURNTABLE_IN_PROGRESS | DONE | FAILED
  currentStep String?   // e.g. "tts_seg_0", "video_seg_2", "render"
  totalSteps  Int       @default(0)
  doneSteps   Float     @default(0)
  workerId    String?   // hostname-pid of the worker that claimed this
  startedAt   DateTime?
  completedAt DateTime?
  errorLog    String?
  config      String?   // JSON: scene strategy, TTS params, etc.
  durationMs  Int?      // Total execution time in ms (populated on DONE)
  creditsUsed Float     @default(0) // Total estimated credits cost
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)

  // Studio Productions — null for standard news pipeline
  studioType    String? // "interview" | "podcast" | "vtuber" | "localization" | "data_studio" | "narrative_matrix"
  studioPayload String? // JSON: parsed studio script (turns, lines, tickers, perspectives, outputMode, generatedImages)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  logs        JobLog[]

  @@index([companyId, status])
  @@index([status, createdAt])
  @@index([status, type, createdAt])
  @@index([studioType, status])
  @@index([storyId])
  @@index([storyId, status])
  @@index([companyId, createdAt])
  @@index([companyId, status, createdAt])
  @@index([companyId, status, completedAt])
  @@index([companyId, type, status])
}


model JobLog {
  id        String        @id @default(cuid())
  jobId     String
  job       GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  step      String        // e.g. "tts_seg_0", "video_seg_2", "render", "queued", "failed", "retry"
  status    String        // "STARTED", "COMPLETED", "FAILED", "INFO"
  message   String?
  duration  Int?          // duration in ms
  createdAt DateTime      @default(now())

  @@index([jobId, createdAt])
}

model PersonaImagePair {
  id        String   @id @default(cuid())
  personaId String
  persona   Persona  @relation(fields: [personaId], references: [id], onDelete: Cascade)
  label     String   // e.g. "Ruby — Green Dress Studio"
  image1Key String   // S3 storage key — primary angle (required)
  image2Key String?  // S3 storage key — second angle (optional)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([personaId])
}

model Worker {
  id               String    @id // workerId = hostname-pid
  hostname         String
  type             String    @default("full") // "audio" | "video_bubble" | "video_full" | "render" | "full"
  status           String    @default("idle") // "idle" | "busy" | "draining" | "offline"
  currentJobId     String?
  currentStep      String?
  gpuMemoryUsedMB  Int?
  gpuMemoryTotalMB Int?
  ip               String?   // IP address of the worker
  lastSeenAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())

  @@index([status, lastSeenAt])
  @@index([lastSeenAt])
}

// NOTE: NextAuth models (User, Account, Session, VerificationToken) were removed.
// This project uses Clerk for authentication — no NextAuth models are needed.


model AiTokenUsage {
  id               String   @id @default(cuid())
  companyId        String?
  company          Company?  @relation(fields: [companyId], references: [id])
  provider         String   // "gemini" | "ollama"
  model            String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  estimatedCost    Float
  storyId          String?
  createdAt        DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([provider, createdAt])
}

model ContactRequest {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  message   String?
  status    String   @default("NEW") // "NEW" | "CONTACTED" | "ARCHIVED"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Platform access requests. A signed-in but unapproved user asks for admin
// access from /pending-approval; a super admin approves (grants Clerk
// publicMetadata.role="admin") or rejects. Not tenant-scoped — reviewed by
// super admins. One row per Clerk user (re-requests upsert).
model AccessRequest {
  id         String    @id @default(cuid())
  userId     String    @unique // Clerk user id
  email      String
  name       String?
  orgId      String? // active Clerk org at request time, if any
  message    String?
  status     String    @default("pending") // "pending" | "approved" | "rejected"
  reviewedBy String? // super admin email who actioned it
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// ============================================================
// Sprint 0 Presets — Visual Presets Registry
// ============================================================

model VisualPreset {
  id             String   @id @default(cuid())
  name           String
  desc           String
  imageDesc      String?
  videoDesc      String?
  soundEffects   String?
  category       String   // "attire" | "nudeSheer" | "scenarios" | "actions"
  subCategory    String   // e.g. "Professional Newsroom Attire", "Nude - Multi-Persona Interactions"
  subSubCategory String?  // e.g. "Restraints & Bondage", "Office & Corporate Furniture"
  categoryPath   String?  // Materialized path for arbitrary depth (e.g., "/templates/studio/anchor/dual")
  tags           String?  // JSON string array of tags
  previewPath    String?  // path to the rendered preview image
  isCustom       Boolean  @default(false)
  isStudioApproved Boolean  @default(false)
  isFullAttire     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category, subCategory, name])
  @@index([category, subCategory])
  @@index([category, subCategory, subSubCategory])
  @@index([isStudioApproved])
  @@index([isFullAttire])
  @@index([categoryPath])
}

// ============================================================
// Ruby E-Commerce Studio — Autonomous Product-to-Video Engine
// ============================================================

model Storefront {
  id            String            @id @default(cuid())
  companyId     String
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String            // e.g. "StoreHaus"
  url           String            // e.g. "https://www.storehaus.com.ar/"
  platform      String            @default("tiendanube") // "tiendanube" | "shopify" | "woocommerce" | "custom"
  logoUrl       String?
  description   String?
  currency      String            @default("ARS")
  lastScrapedAt DateTime?
  productCount  Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  products      ProductCampaign[]

  @@unique([companyId, url])
  @@index([companyId])
  @@index([companyId, createdAt])
}

model ProductCampaign {
  id           String         @id @default(cuid())
  companyId    String
  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  storefrontId String?
  storefront   Storefront?    @relation(fields: [storefrontId], references: [id], onDelete: SetNull)
  brandId      String?
  brand        Brand?         @relation(fields: [brandId], references: [id], onDelete: SetNull)
  title        String
  sourceUrl    String
  vendor       String?
  price        Float          @default(0)
  comparePrice Float?
  currency     String         @default("USD")
  typology     String         @default("discrete_object") // "discrete_object" | "surface_material" | "apparel_wearable" | "sensory_consumable" | "bulky_furniture" | "digital_saas" | "local_service"
  status       String         @default("DRAFT") // "DRAFT" | "PROCESSING" | "READY" | "FAILED"
  rawMetadata  String         // Serialized ProductSpec JSON
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  assets       ProductAsset[]
  variations   AdVariation[]
  assets3D     Product3DAsset[]

  @@unique([companyId, sourceUrl])
  @@index([companyId, status])
  @@index([companyId, typology])
  @@index([companyId, typology, createdAt])
  @@index([storefrontId])
  @@index([brandId])
  @@index([companyId, brandId])
  @@index([companyId, createdAt])
  @@index([companyId, price])
  @@index([companyId, storefrontId, createdAt])
}

model ProductAsset {
  id         String          @id @default(cuid())
  campaignId String
  campaign   ProductCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  assetType  String          // "hero_packshot" | "detail_macro" | "lifestyle_context" | "customer_ugc" | "existing_video" | "dimension_schematic" | "before_after_pair"
  rawUrl     String
  storageKey String?
  mattedKey  String?         // Transparent cutout key
  width      Int?
  height     Int?
  isPrimary  Boolean         @default(false)
  createdAt  DateTime        @default(now())

  @@unique([campaignId, rawUrl])
  @@index([campaignId, assetType])
}

model AdVariation {
  id               String          @id @default(cuid())
  campaignId       String
  campaign         ProductCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  archetype        String          // "pdp_showcase" | "amazon_compliant" | "us_vs_them" | "flash_sale" | "viral_ugc" | "onboarding_guide"
  targetChannel    String          @default("shopify_pdp") // "shopify_pdp" | "amazon_listing" | "tiktok_shop" | "meta_ads" | "youtube_shorts" | "instagram_reels" | "email_loop" | "connected_tv"
  aspectRatio      String          @default("9:16") // "9:16" | "16:9" | "1:1" | "4:5"
  audioMode        String          @default("voiceover_tts") // "voiceover_tts" | "silent_subtitles" | "ambient_music_only"
  status           String          @default("PENDING") // "PENDING" | "RENDERING" | "COMPLETED" | "FAILED"
  scriptJson       String          // Serialized AdScript JSON
  renderedVideoKey String?
  renderedWebmKey  String?
  renderedGifKey   String?
  thumbnailKey     String?
  durationSeconds  Float           @default(20.0)
  embedCodeSnippet String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([campaignId, status])
  @@index([campaignId, archetype])
  @@index([campaignId, createdAt])
}

// 3D Product Turntable — single image → normalized GLB → 360° turntable video
// (docs/3D-TURNTABLE-PRD.md, Object3D-Server on port 8020). Re-generation creates
// a NEW row (revisions); re-rendering an existing mesh updates the row in place.
model Product3DAsset {
  id              String          @id @default(cuid())
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaignId      String
  campaign        ProductCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  // Source
  sourceAssetId   String?         // ProductAsset id used as input image
  sourceImageKey  String          // Storage key OR absolute URL of the input image

  // Engine metadata
  engine          String          @default("auto") // "auto" | engine name reported by Object3D-Server (e.g. "hunyuan3d_mini" | "instantmesh" | "trellis")
  quality         String          @default("standard") // "draft" | "standard" | "premium"
  inferenceMs     Int?            // Reconstruction inference time in ms
  bgRemovalMs     Int?            // Background removal time in ms
  vertexCount     Int?
  faceCount       Int?
  textureSize     String?         // e.g. "1024x1024"
  vramPeakGb      Float?

  // Output assets (storage keys — resolve with storage.getUrl)
  meshKey         String?         // tenants/{companyId}/3d-objects/{assetId}/mesh.glb
  previewKey      String?         // tenants/{companyId}/3d-objects/{assetId}/preview.png (0° render)
  turntableKey    String?         // tenants/{companyId}/3d-turntables/{assetId}/turntable.webm (VP9 + alpha)
  turntableMp4Key String?         // tenants/{companyId}/3d-turntables/{assetId}/turntable.mp4 (H.264, opaque)
  contactSheetKey String?         // tenants/{companyId}/3d-turntables/{assetId}/contact_sheet.png (8 orientations)

  // Turntable render settings
  frames          Int             @default(120)
  fps             Int             @default(30)
  width           Int             @default(1080)
  height          Int             @default(1080)
  background      String          @default("transparent") // "transparent" | "white" | "studio_dark" | "studio_light"
  cameraPreset    String          @default("product_three_quarter") // "product_three_quarter" | "product_front" | "product_low_angle" | "product_high_angle" | "product_closeup"

  status          String          @default("PENDING") // "PENDING" | "RECONSTRUCTING" | "RENDERING" | "READY" | "FAILED"
  errorLog        String?
  generationJobId String?         // Latest GenerationJob (type "turntable_3d") for progress tracking
  serverJobId     String?         // Reconstruct job id on Object3D-Server (rc_…)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([companyId, status])
  @@index([campaignId])
  @@index([generationJobId])
}

// Global & Tenant System Settings (admin-settings, voice-studio-settings)
model SystemSetting {
  id        String   @id @default(cuid())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  key       String   // "admin_settings" | "voice_studio_settings"
  value     String   // Serialized JSON payload
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, key])
  @@index([key])
  @@index([companyId])
}


