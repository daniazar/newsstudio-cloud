{
  "name": "ruby-news-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --max-old-space-size=4096 --expose-gc node_modules/next/dist/bin/next dev --webpack",
    "dev:turbo": "node --max-old-space-size=4096 --expose-gc node_modules/next/dist/bin/next dev --turbopack",
    "build": "node --max-old-space-size=3072 node_modules/next/dist/bin/next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:critical": "vitest run src/app/api/health/__tests__/health.test.ts src/app/api/stories/__tests__/stories.test.ts src/app/api/feeds/__tests__/feeds.test.ts src/app/api/personas/__tests__/personas.test.ts src/lib/storage/__tests__/storage.test.ts src/lib/tenant/__tests__/tenant.test.ts",
    "prepare": "husky install",
    "hooks:setup": "bash scripts/setup-husky.sh",
    "postinstall": "node scripts/patch-remotion-junction.js",
    "remotion:bundle": "remotion bundle src/remotion/Root.tsx --out-dir=build",
    "worker": "tsx --env-file=.env workers/pipeline-worker/index.ts",
    "worker:audio": "tsx --env-file=.env workers/pipeline-worker/index.ts --role=audio",
    "worker:video": "tsx --env-file=.env workers/pipeline-worker/index.ts --role=video",
    "worker:render": "tsx --env-file=.env workers/pipeline-worker/index.ts --role=render",
    "worker:cli": "tsx scripts/worker-cli.ts",
    "image:cli": "tsx scripts/image-cli.ts",
    "gemini:image": "tsx scripts/gemini-image-cli.ts",
    "clone:persona": "tsx --env-file=.env scripts/clone-persona-cli.ts",
    "test-drive:persona": "tsx --env-file=.env scripts/test-drive-persona.ts",
    "clip:viral": "tsx --env-file=.env scripts/viral-clipper-cli.ts",
    "situation:room": "tsx --env-file=.env scripts/situation-room-cli.ts",
    "gemini:audit": "tsx scripts/gemini-image-cli.ts --mode=audit",
    "veo:video": "tsx scripts/veo-cli.ts",
    "veo:cli": "tsx scripts/veo-cli.ts",
    "loop:audit": "tsx scripts/audit-video-loops.ts",
    "detect:talking": "python scripts/detect_talking_personas.py",
    "detect:talking:gpu": "python scripts/detect_talking_gpu.py",
    "chrome:debug": "powershell -ExecutionPolicy Bypass -File scripts/start-chrome-debug.ps1",
    "generate:uncensored-refs": "tsx scripts/generate-uncensored-ref-cli.ts",
    "worker:orchestrator": "tsx --env-file=.env scripts/worker-orchestrator.ts",
    "studio": "tsx scripts/studio-cli.ts",
    "latenight": "tsx scripts/late-night-cli.ts",
    "futurecast": "tsx scripts/future-cast-cli.ts",
    "darwin:evolve": "tsx scripts/darwin-evolution-cli.ts",
    "forensic:doc": "tsx scripts/forensic-investigator-cli.ts",
    "prism": "tsx scripts/perspective-prism-cli.ts",
    "quantum:stream": "tsx scripts/quantum-broadcast-cli.ts",
    "society:lab": "tsx scripts/synthetic-society-cli.ts",
    "totem:cli": "tsx scripts/totem-cli.ts",
    "qc": "tsx scripts/qc-director-cli.ts",
    "roundtable": "tsx scripts/roundtable-cli.ts",
    "ecommerce": "tsx scripts/ecommerce-cli.ts",
    "shorts:clipper": "tsx scripts/shorts-clipper-cli.ts",
    "localize": "tsx scripts/localization-cli.ts",
    "lora:factory": "tsx scripts/lora-factory-cli.ts",
    "agent": "tsx --env-file=.env scripts/agent-cli.ts",
    "handoff": "tsx scripts/agent-handoff.ts",
    "workers:launch": "tsx scripts/launch-workers.ts",
    "db:init": "prisma generate && prisma db push && tsx scripts/init-personas.ts && tsx scripts/init-brand.ts",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "comfy:start": "python scripts/launch_comfyui.py",
    "docker:cli": "tsx scripts/docker-cli.ts",
    "docker:status": "tsx scripts/docker-cli.ts status",
    "docker:up": "tsx scripts/docker-cli.ts start",
    "docker:down": "tsx scripts/docker-cli.ts stop",
    "docker:restart": "tsx scripts/docker-cli.ts restart",
    "docker:logs": "tsx scripts/docker-cli.ts logs",
    "anchor:preprocess": "tsx scripts/anchor-preprocessor-cli.ts",
    "docker:build": "tsx scripts/docker-cli.ts build",
    "docker:mode": "tsx scripts/docker-cli.ts mode",
    "docker:flush": "tsx scripts/docker-cli.ts flush",
    "docker:th": "tsx scripts/docker-cli.ts mode modern-talkinghead",
    "docker:th:musetalk": "tsx scripts/docker-cli.ts mode modern-talkinghead musetalk",
    "docker:th:ditto": "tsx scripts/docker-cli.ts mode modern-talkinghead ditto",
    "docker:th:standby": "tsx scripts/docker-cli.ts mode modern-talkinghead standby",
    "docker:calibrate": "tsx scripts/docker-cli.ts calibrate",
    "gpu:calibrate": "docker exec modern-talkinghead-server python /app/setup_hardware.py",
    "docker:tts-build": "docker compose -f docker-compose.ai.yml build modern-tts",
    "docker:tts-up": "docker compose -f docker-compose.ai.yml up modern-tts -d",
    "docker:tts-samples": "docker exec modern-tts-server python generate_voice_samples.py",
    "start:modern-tts": "tsx scripts/start-modern-tts.ts",
    "modern-tts:lightweight": "tsx scripts/start-modern-tts.ts --profile=lightweight",
    "modern-tts:studio": "tsx scripts/start-modern-tts.ts --profile=studio",
    "modern-tts:full": "tsx scripts/start-modern-tts.ts --profile=full",
    "start:voice-bot": "tsx scripts/start-voice-bot-stack.ts",
    "profile:tts": "tsx scripts/forensic-tts-profiler-cli.ts",
    "telemetry": "tsx scripts/telemetry-cli.ts",
    "stats": "tsx scripts/telemetry-cli.ts",
    "cost:report": "tsx scripts/cost-cli.ts",
    "ledger": "tsx scripts/cost-cli.ts",
    "sleep": "tsx scripts/sleep-cli.ts",
    "sleep:headless": "tsx scripts/sleep-cli.ts headless",
    "sleep:clean": "tsx scripts/sleep-cli.ts clean",
    "sleep:hibernate": "tsx scripts/sleep-cli.ts hibernate",
    "storage:audit": "tsx scripts/audit-storage-orphans.ts",
    "storage:clean": "tsx scripts/audit-storage-orphans.ts --clean",
    "liveportrait:server": "tsx scripts/liveportrait-server-cli.ts",
    "benchmark:avatar": "tsx scripts/benchmark/benchmark_hybrid_avatar_engine.ts",
    "motion:setup": "tsx scripts/setup-motion-engines.ts",
    "motion:setup:clone": "tsx scripts/setup-motion-engines.ts --clone",
    "motion:preprocess": "tsx scripts/preprocess-motion-loops.ts",
    "motion:preprocess:force": "tsx scripts/preprocess-motion-loops.ts --force",
    "persona:preprocess": "tsx scripts/preprocess-persona-appearance.ts",
    "persona:preprocess:force": "tsx scripts/preprocess-persona-appearance.ts --force"
  },
